# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Hyperliquid ---------------------------------------------------------
# The recorder reads PUBLIC mainnet data and needs no credentials at all.
# These are only required later, for testnet execution (qfr/strategy/).
#
# NEVER put a mainnet key here. Testnet only.
HL_ENV=testnet
HL_ACCOUNT_ADDRESS=
HL_API_WALLET_KEY=

# --- IBM Quantum ---------------------------------------------------------
# From https://quantum.cloud.ibm.com — Open Plan gives 10 min QPU / 28 days.
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=

# --- Storage -------------------------------------------------------------
QFR_DATA_DIR=./data
